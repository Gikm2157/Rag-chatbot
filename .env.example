# DeepSeek uses an OpenAI-compatible API
LLM_PROVIDER=openai
LLM_MODEL=deepseek-flash

OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_API_BASE=https://api.deepseek.com
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Embedding provider: openai | huggingface
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=./models/bge-small-zh-v1.5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=86400

# Authentication
AUTH_DB_PATH=./data/auth.db
AUTH_SESSION_TTL_SECONDS=86400
AUTH_SESSION_COOKIE_NAME=rag_session
# 本地开发可为 false；HTTPS 部署时应改为 true
AUTH_COOKIE_SECURE=false
# 首次启动时创建管理员；已有同名用户不会被覆盖
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace_with_a_strong_password

# Conversation memory: 10 messages = 5 turns, 20 messages = 10 turns
MEMORY_RECENT_MESSAGE_LIMIT=10
SUMMARY_TRIGGER_MESSAGE_COUNT=20

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=policies

# Retrieval
# Chunks below this score are dropped — bot replies "I don't know" instead of hallucinating
# 0.5 is balanced; raise to 0.7 for stricter grounding, lower to 0.3 if too many false negatives
RETRIEVAL_SCORE_THRESHOLD=0.3

# Ingest limits
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=120

# App
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
